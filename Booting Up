--// Very Very Gud UI Library
--// Booting Up + Window + Button + Toggle + Slider

local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local Library = {}

--==================================================
-- BOOTING UP
--==================================================

local BootGui = Instance.new("ScreenGui")
BootGui.Name = "LibraryBoot"
BootGui.ResetOnSpawn = false
BootGui.Parent = CoreGui

local BootFrame = Instance.new("Frame")
BootFrame.Size = UDim2.fromOffset(230,120)
BootFrame.Position = UDim2.new(0.5,-115,0.5,-60)
BootFrame.BackgroundColor3 = Color3.fromRGB(25,25,25)
BootFrame.BorderSizePixel = 0
BootFrame.Parent = BootGui

local BootCorner = Instance.new("UICorner")
BootCorner.CornerRadius = UDim.new(0,10)
BootCorner.Parent = BootFrame

local BootText = Instance.new("TextLabel")
BootText.Size = UDim2.new(1,0,0,30)
BootText.Position = UDim2.fromOffset(0,20)
BootText.BackgroundTransparency = 1
BootText.Text = "Booting up..."
BootText.TextColor3 = Color3.new(1,1,1)
BootText.Font = Enum.Font.SourceSansBold
BootText.TextSize = 22
BootText.Parent = BootFrame

local BarBack = Instance.new("Frame")
BarBack.Size = UDim2.fromOffset(190,7)
BarBack.Position = UDim2.new(0.5,-95,0,70)
BarBack.BackgroundColor3 = Color3.fromRGB(50,50,50)
BarBack.BorderSizePixel = 0
BarBack.Parent = BootFrame

local BarCorner = Instance.new("UICorner")
BarCorner.CornerRadius = UDim.new(1,0)
BarCorner.Parent = BarBack

local Bar = Instance.new("Frame")
Bar.Size = UDim2.new(0,0,1,0)
Bar.BackgroundColor3 = Color3.fromRGB(110,110,110)
Bar.BorderSizePixel = 0
Bar.Parent = BarBack

local BarCorner2 = Instance.new("UICorner")
BarCorner2.CornerRadius = UDim.new(1,0)
BarCorner2.Parent = Bar

TweenService:Create(
	Bar,
	TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	{
		Size = UDim2.new(1,0,1,0)
	}
):Play()

task.wait(2)

BootGui:Destroy()

--==================================================
-- CREATE WINDOW
--==================================================

function Library:CreateWindow(Name)

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "MiniLibrary"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.Parent = CoreGui

	--==================================================
	-- MAIN FRAME
	--==================================================

	local Frame = Instance.new("Frame")
	Frame.Name = "Window"
	Frame.Size = UDim2.fromOffset(165,185)
	Frame.Position = UDim2.new(0.5,-82,0.5,-92)
	Frame.BackgroundColor3 = Color3.fromRGB(35,35,35)
	Frame.BorderSizePixel = 0
	Frame.ClipsDescendants = true
	Frame.Active = true
	Frame.Parent = ScreenGui

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,8)
	Corner.Parent = Frame

	--==================================================
	-- TOP BAR
	--==================================================

	local TopBar = Instance.new("Frame")
	TopBar.Size = UDim2.new(1,0,0,25)
	TopBar.BackgroundTransparency = 1
	TopBar.Active = true
	TopBar.ZIndex = 10
	TopBar.Parent = Frame

	--==================================================
	-- MINIMIZE
	--==================================================

	local Minimize = Instance.new("TextButton")
	Minimize.Size = UDim2.fromOffset(25,25)
	Minimize.BackgroundTransparency = 1
	Minimize.Text = "−"
	Minimize.TextColor3 = Color3.new(1,1,1)
	Minimize.Font = Enum.Font.SourceSansBold
	Minimize.TextSize = 22
	Minimize.AutoButtonColor = false
	Minimize.ZIndex = 11
	Minimize.Parent = TopBar

	--==================================================
	-- TITLE
	--==================================================

	local Title = Instance.new("TextLabel")
	Title.Size = UDim2.new(1,-50,1,0)
	Title.Position = UDim2.fromOffset(30,0)
	Title.BackgroundTransparency = 1
	Title.Text = Name or "Mini Library"
	Title.TextColor3 = Color3.new(1,1,1)
	Title.Font = Enum.Font.SourceSansBold
	Title.TextSize = 20
	Title.TextXAlignment = Enum.TextXAlignment.Center
	Title.ZIndex = 11
	Title.Parent = TopBar

	--==================================================
	-- SCROLLING CONTENT
	--==================================================

	local Content = Instance.new("ScrollingFrame")
	Content.Name = "Content"
	Content.Size = UDim2.new(1,-6,1,-31)
	Content.Position = UDim2.fromOffset(3,28)
	Content.BackgroundTransparency = 1
	Content.BorderSizePixel = 0
	Content.ScrollingDirection = Enum.ScrollingDirection.Y
	Content.ScrollingEnabled = true
	Content.ScrollBarThickness = 3
	Content.ScrollBarImageColor3 = Color3.fromRGB(100,100,100)
	Content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Content.CanvasSize = UDim2.new(0,0,0,0)
	Content.Active = true
	Content.ZIndex = 2
	Content.Parent = Frame

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0,5)
	Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	Layout.VerticalAlignment = Enum.VerticalAlignment.Top
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Content

	local Padding = Instance.new("UIPadding")
	Padding.PaddingTop = UDim.new(0,2)
	Padding.PaddingBottom = UDim.new(0,5)
	Padding.Parent = Content

	--==================================================
	-- DRAGGING
	--==================================================

	local Dragging = false
	local DragStart
	local StartPosition

	TopBar.InputBegan:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			DragStart = Input.Position
			StartPosition = Frame.Position

			Input.Changed:Connect(function()

				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end

			end)

		end

	end)

	UIS.InputChanged:Connect(function(Input)

		if not Dragging then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch then

			local Delta = Input.Position - DragStart

			Frame.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,

				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)

		end

	end)

	--==================================================
	-- MINIMIZE
	--==================================================

	local Minimized = false
	local NormalHeight = 185

	Minimize.MouseButton1Click:Connect(function()

		Minimized = not Minimized

		if Minimized then

			Minimize.Text = "+"

			TweenService:Create(
				Frame,
				TweenInfo.new(0.3, Enum.EasingStyle.Quint),
				{
					Size = UDim2.fromOffset(
						Frame.AbsoluteSize.X,
						25
					)
				}
			):Play()

		else

			Minimize.Text = "−"

			TweenService:Create(
				Frame,
				TweenInfo.new(
					0.35,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.fromOffset(
						Frame.AbsoluteSize.X,
						NormalHeight
					)
				}
			):Play()

		end

	end)

	--==================================================
	-- WINDOW OBJECT
	--==================================================

	local Window = {}

	Window.Frame = Frame
	Window.ScreenGui = ScreenGui
	Window.Content = Content

	--==================================================
	-- BUTTON
	--==================================================

	function Window:CreateButton(Name, Order, Callback)

		Name = tostring(Name or "Button")

		local Bounds = TextService:GetTextSize(
			Name,
			18,
			Enum.Font.SourceSansBold,
			Vector2.new(1000,25)
		)

		local TargetWidth = math.max(165, Bounds.X + 40)
		TargetWidth = math.min(TargetWidth, 400)

		if TargetWidth > Frame.AbsoluteSize.X then

			TweenService:Create(
				Frame,
				TweenInfo.new(0.25, Enum.EasingStyle.Quint),
				{
					Size = UDim2.fromOffset(
						TargetWidth,
						Frame.AbsoluteSize.Y
					)
				}
			):Play()

		end

		local Button = Instance.new("TextButton")
		Button.Size = UDim2.new(1,-10,0,25)
		Button.BackgroundColor3 = Color3.fromRGB(60,60,60)
		Button.TextColor3 = Color3.new(1,1,1)
		Button.Text = Name
		Button.Font = Enum.Font.SourceSansBold
		Button.TextSize = 18
		Button.TextWrapped = false
		Button.LayoutOrder = Order or 1
		Button.AutoButtonColor = false
		Button.ZIndex = 3
		Button.Parent = Content

		local C = Instance.new("UICorner")
		C.CornerRadius = UDim.new(0,6)
		C.Parent = Button

		Button.MouseEnter:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Color3.fromRGB(75,75,75)
				}
			):Play()

		end)

		Button.MouseLeave:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Color3.fromRGB(60,60,60),
					Size = UDim2.new(1,-10,0,25)
				}
			):Play()

		end)

		Button.MouseButton1Down:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(0.08),
				{
					Size = UDim2.new(1,-15,0,23)
				}
			):Play()

		end)

		Button.MouseButton1Up:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(0.12, Enum.EasingStyle.Back),
				{
					Size = UDim2.new(1,-10,0,25)
				}
			):Play()

		end)

		Button.MouseButton1Click:Connect(function()

			if Callback then
				task.spawn(Callback)
			end

		end)

		return Button
	end

	--==================================================
	-- TOGGLE
	--==================================================

	function Window:CreateToggle(Name, Order, Default, Callback)

		local Enabled = Default == true

		local Toggle = Instance.new("TextButton")
		Toggle.Size = UDim2.new(1,-10,0,30)
		Toggle.BackgroundColor3 = Color3.fromRGB(60,60,60)
		Toggle.Text = Name
		Toggle.TextColor3 = Color3.new(1,1,1)
		Toggle.Font = Enum.Font.SourceSansBold
		Toggle.TextSize = 18
		Toggle.TextXAlignment = Enum.TextXAlignment.Left
		Toggle.LayoutOrder = Order or 1
		Toggle.AutoButtonColor = false
		Toggle.ZIndex = 3
		Toggle.Parent = Content

		local Padding = Instance.new("UIPadding")
		Padding.PaddingLeft = UDim.new(0,8)
		Padding.Parent = Toggle

		local C = Instance.new("UICorner")
		C.CornerRadius = UDim.new(0,6)
		C.Parent = Toggle

		local Indicator = Instance.new("Frame")
		Indicator.Size = UDim2.fromOffset(36,18)
		Indicator.Position = UDim2.new(1,-44,0.5,-9)
		Indicator.BorderSizePixel = 0
		Indicator.Parent = Toggle

		local IC = Instance.new("UICorner")
		IC.CornerRadius = UDim.new(1,0)
		IC.Parent = Indicator

		local Circle = Instance.new("Frame")
		Circle.Size = UDim2.fromOffset(14,14)
		Circle.AnchorPoint = Vector2.new(0,0.5)
		Circle.Position = Enabled
			and UDim2.new(1,-16,0.5,0)
			or UDim2.fromOffset(2,9)
		Circle.BackgroundColor3 = Color3.new(1,1,1)
		Circle.BorderSizePixel = 0
		Circle.Parent = Indicator

		local CC = Instance.new("UICorner")
		CC.CornerRadius = UDim.new(1,0)
		CC.Parent = Circle

		local function Update()

			TweenService:Create(
				Indicator,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Enabled
						and Color3.fromRGB(90,170,90)
						or Color3.fromRGB(45,45,45)
				}
			):Play()

			TweenService:Create(
				Circle,
				TweenInfo.new(0.15, Enum.EasingStyle.Quad),
				{
					Position = Enabled
						and UDim2.new(1,-16,0.5,0)
						or UDim2.fromOffset(2,9)
				}
			):Play()

			if Callback then
				task.spawn(Callback, Enabled)
			end

		end

		Update()

		Toggle.MouseButton1Click:Connect(function()

			Enabled = not Enabled
			Update()

		end)

		return Toggle
	end

	--==================================================
	-- SLIDER
	--==================================================

	function Window:CreateSlider(Name, Order, Min, Max, Default, Callback)

		Min = Min or 0
		Max = Max or 100
		Default = math.clamp(Default or Min, Min, Max)

		local Slider = Instance.new("Frame")
		Slider.Size = UDim2.new(1,-10,0,42)
		Slider.BackgroundColor3 = Color3.fromRGB(60,60,60)
		Slider.BorderSizePixel = 0
		Slider.LayoutOrder = Order or 1
		Slider.ZIndex = 3
		Slider.Parent = Content

		local C = Instance.new("UICorner")
		C.CornerRadius = UDim.new(0,6)
		C.Parent = Slider

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1,-55,0,20)
		Label.Position = UDim2.fromOffset(7,2)
		Label.BackgroundTransparency = 1
		Label.Text = Name
		Label.TextColor3 = Color3.new(1,1,1)
		Label.Font = Enum.Font.SourceSansBold
		Label.TextSize = 17
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Slider

		local ValueLabel = Instance.new("TextLabel")
		ValueLabel.Size = UDim2.fromOffset(45,20)
		ValueLabel.Position = UDim2.new(1,-50,0,2)
		ValueLabel.BackgroundTransparency = 1
		ValueLabel.Text = tostring(Default)
		ValueLabel.TextColor3 = Color3.new(1,1,1)
		ValueLabel.Font = Enum.Font.SourceSansBold
		ValueLabel.TextSize = 16
		ValueLabel.Parent = Slider

		local Bar = Instance.new("Frame")
		Bar.Size = UDim2.new(1,-14,0,7)
		Bar.Position = UDim2.new(0,7,1,-12)
		Bar.BackgroundColor3 = Color3.fromRGB(40,40,40)
		Bar.BorderSizePixel = 0
		Bar.Active = true
		Bar.Parent = Slider

		local BC = Instance.new("UICorner")
		BC.CornerRadius = UDim.new(1,0)
		BC.Parent = Bar

		local Fill = Instance.new("Frame")
		Fill.Size = UDim2.new(
			(Default-Min)/(Max-Min),
			0,
			1,
			0
		)
		Fill.BackgroundColor3 = Color3.fromRGB(110,110,110)
		Fill.BorderSizePixel = 0
		Fill.Parent = Bar

		local FC = Instance.new("UICorner")
		FC.CornerRadius = UDim.new(1,0)
		FC.Parent = Fill

		local Knob = Instance.new("Frame")
		Knob.Size = UDim2.fromOffset(13,13)
		Knob.AnchorPoint = Vector2.new(0.5,0.5)
		Knob.Position = UDim2.new(
			(Default-Min)/(Max-Min),
			0,
			0.5,
			0
		)
		Knob.BackgroundColor3 = Color3.new(1,1,1)
		Knob.BorderSizePixel = 0
		Knob.Parent = Bar

		local KC = Instance.new("UICorner")
		KC.CornerRadius = UDim.new(1,0)
		KC.Parent = Knob

		local Sliding = false
		local Value = Default

		local function SetValue(NewValue)

			Value = math.clamp(
				math.round(NewValue),
				Min,
				Max
			)

			local Percent = (Value-Min)/(Max-Min)

			ValueLabel.Text = tostring(Value)

			TweenService:Create(
				Fill,
				TweenInfo.new(0.08),
				{
					Size = UDim2.new(Percent,0,1,0)
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(0.08),
				{
					Position = UDim2.new(Percent,0,0.5,0)
				}
			):Play()

			if Callback then
				task.spawn(Callback, Value)
			end

		end

		local function UpdateFromInput(Input)

			local Percent = math.clamp(
				(Input.Position.X - Bar.AbsolutePosition.X)
				/ Bar.AbsoluteSize.X,
				0,
				1
			)

			SetValue(
				Min + ((Max-Min) * Percent)
			)

		end

		Bar.InputBegan:Connect(function(Input)

			if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

				Sliding = true
				UpdateFromInput(Input)

			end

		end)

		UIS.InputChanged:Connect(function(Input)

			if not Sliding then
				return
			end

			if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then

				UpdateFromInput(Input)

			end

		end)

		UIS.InputEnded:Connect(function(Input)

			if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

				Sliding = false

			end

		end)

		return Slider
	end

	return Window
end

return Library