--// Very Very Gud UI Library
--// Booting Up

local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local Library = {}

--==================================================
-- BOOTING UP ANIMATION
--==================================================

local BootGui = Instance.new("ScreenGui")
BootGui.Name = "LibraryBoot"
BootGui.ResetOnSpawn = false
BootGui.Parent = CoreGui

local BootFrame = Instance.new("Frame")
BootFrame.Size = UDim2.fromOffset(230,120)
BootFrame.Position = UDim2.new(0.5,-115,0.5,-60)
BootFrame.BackgroundColor3 = Color3.fromRGB(25,25,25)
BootFrame.BorderSizePixel = 0
BootFrame.Parent = BootGui

local BootCorner = Instance.new("UICorner")
BootCorner.CornerRadius = UDim.new(0,10)
BootCorner.Parent = BootFrame

local BootText = Instance.new("TextLabel")
BootText.Size = UDim2.new(1,0,0,30)
BootText.Position = UDim2.fromOffset(0,20)
BootText.BackgroundTransparency = 1
BootText.Text = "Booting up..."
BootText.TextColor3 = Color3.new(1,1,1)
BootText.Font = Enum.Font.SourceSansBold
BootText.TextSize = 22
BootText.Parent = BootFrame

local BarBack = Instance.new("Frame")
BarBack.Size = UDim2.fromOffset(190,7)
BarBack.Position = UDim2.new(0.5,-95,0,70)
BarBack.BackgroundColor3 = Color3.fromRGB(50,50,50)
BarBack.BorderSizePixel = 0
BarBack.Parent = BootFrame

local BarCorner = Instance.new("UICorner")
BarCorner.CornerRadius = UDim.new(1,0)
BarCorner.Parent = BarBack

local Bar = Instance.new("Frame")
Bar.Size = UDim2.new(0,0,1,0)
Bar.BackgroundColor3 = Color3.fromRGB(110,110,110)
Bar.BorderSizePixel = 0
Bar.Parent = BarBack

local BarFillCorner = Instance.new("UICorner")
BarFillCorner.CornerRadius = UDim.new(1,0)
BarFillCorner.Parent = Bar

TweenService:Create(
	Bar,
	TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	{
		Size = UDim2.new(1,0,1,0)
	}
):Play()

task.wait(2)

BootGui:Destroy()

--==================================================
-- WINDOW TEMPLATE
--==================================================

function Library:CreateWindow(Name)

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "MiniLibrary"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.Parent = CoreGui

	--==================================================
	-- MAIN WINDOW
	--==================================================

	local Frame = Instance.new("Frame")
	Frame.Name = "Window"
	Frame.Size = UDim2.fromOffset(165,185)
	Frame.Position = UDim2.new(0.5,-82,0.5,-92)
	Frame.BackgroundColor3 = Color3.fromRGB(35,35,35)
	Frame.BorderSizePixel = 0
	Frame.ClipsDescendants = true
	Frame.Active = true
	Frame.Parent = ScreenGui

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,8)
	Corner.Parent = Frame

	--==================================================
	-- TOP BAR
	--==================================================

	local TopBar = Instance.new("Frame")
	TopBar.Name = "TopBar"
	TopBar.Size = UDim2.new(1,0,0,25)
	TopBar.BackgroundTransparency = 1
	TopBar.Active = true
	TopBar.ZIndex = 10
	TopBar.Parent = Frame

	--==================================================
	-- MINIMIZE
	--==================================================

	local Minimize = Instance.new("TextButton")
	Minimize.Name = "Minimize"
	Minimize.Size = UDim2.fromOffset(25,25)
	Minimize.Position = UDim2.fromOffset(0,0)
	Minimize.BackgroundTransparency = 1
	Minimize.Text = "−"
	Minimize.TextColor3 = Color3.new(1,1,1)
	Minimize.Font = Enum.Font.SourceSansBold
	Minimize.TextSize = 22
	Minimize.AutoButtonColor = false
	Minimize.ZIndex = 11
	Minimize.Parent = TopBar

	--==================================================
	-- TITLE
	--==================================================

	local Title = Instance.new("TextLabel")
	Title.Name = "Title"
	Title.Size = UDim2.new(1,-50,1,0)
	Title.Position = UDim2.fromOffset(30,0)
	Title.BackgroundTransparency = 1
	Title.Text = Name or "Mini Library"
	Title.TextColor3 = Color3.new(1,1,1)
	Title.Font = Enum.Font.SourceSansBold
	Title.TextSize = 20
	Title.TextXAlignment = Enum.TextXAlignment.Center
	Title.ZIndex = 11
	Title.Parent = TopBar

	--==================================================
	-- SCROLLING CONTENT
	--==================================================

	local Content = Instance.new("ScrollingFrame")
	Content.Name = "Content"
	Content.Size = UDim2.new(1,-6,1,-31)
	Content.Position = UDim2.fromOffset(3,28)
	Content.BackgroundTransparency = 1
	Content.BorderSizePixel = 0
	Content.ScrollingDirection = Enum.ScrollingDirection.Y
	Content.ScrollingEnabled = true
	Content.ScrollBarThickness = 3
	Content.ScrollBarImageColor3 = Color3.fromRGB(100,100,100)
	Content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Content.CanvasSize = UDim2.new(0,0,0,0)
	Content.Active = true
	Content.ZIndex = 2
	Content.Parent = Frame

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0,5)
	Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	Layout.VerticalAlignment = Enum.VerticalAlignment.Top
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Content

	local Padding = Instance.new("UIPadding")
	Padding.PaddingTop = UDim.new(0,2)
	Padding.PaddingBottom = UDim.new(0,5)
	Padding.Parent = Content

	--==================================================
	-- DRAGGING
	--==================================================

	local Dragging = false
	local DragStart
	local StartPosition

	TopBar.InputBegan:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			DragStart = Input.Position
			StartPosition = Frame.Position

			Input.Changed:Connect(function()

				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end

			end)

		end

	end)

	UIS.InputChanged:Connect(function(Input)

		if not Dragging then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch then

			local Delta = Input.Position - DragStart

			Frame.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,

				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)

		end

	end)

	--==================================================
	-- MINIMIZE / RESTORE
	--==================================================

	local Minimized = false
	local NormalHeight = 185

	Minimize.MouseEnter:Connect(function()

		TweenService:Create(
			Minimize,
			TweenInfo.new(0.12),
			{
				TextTransparency = 0.25
			}
		):Play()

	end)

	Minimize.MouseLeave:Connect(function()

		TweenService:Create(
			Minimize,
			TweenInfo.new(0.12),
			{
				TextTransparency = 0
			}
		):Play()

	end)

	Minimize.MouseButton1Click:Connect(function()

		Minimized = not Minimized

		if Minimized then

			Minimize.Text = "+"

			TweenService:Create(
				Frame,
				TweenInfo.new(
					0.3,
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.fromOffset(
						Frame.AbsoluteSize.X,
						25
					)
				}
			):Play()

		else

			Minimize.Text = "−"

			TweenService:Create(
				Frame,
				TweenInfo.new(
					0.35,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.fromOffset(
						Frame.AbsoluteSize.X,
						NormalHeight
					)
				}
			):Play()

		end

	end)

	--==================================================
	-- WINDOW OBJECT
	--==================================================

	local Window = {}

	Window.Frame = Frame
	Window.ScreenGui = ScreenGui
	Window.Content = Content

	--==================================================
	-- BUTTON TEMPLATE
	--==================================================

	function Window:CreateButton(Name, Order, Callback)

		Name = tostring(Name or "Button")

		-- Calculate how wide the text needs to be
		local TextBounds = TextService:GetTextSize(
			Name,
			18,
			Enum.Font.SourceSansBold,
			Vector2.new(1000,25)
		)

		local RequiredWidth = TextBounds.X + 40

		-- Minimum width = 165
		local TargetWidth = math.max(165, RequiredWidth)

		-- Maximum width prevents ridiculously huge windows
		local MaxWidth = 400
		TargetWidth = math.min(TargetWidth, MaxWidth)

		-- Resize window if necessary
		if TargetWidth > Frame.AbsoluteSize.X then

			TweenService:Create(
				Frame,
				TweenInfo.new(
					0.25,
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.fromOffset(
						TargetWidth,
						Frame.AbsoluteSize.Y
					)
				}
			):Play()

		end

		--==================================================
		-- BUTTON
		--==================================================

		local Button = Instance.new("TextButton")

		Button.Size = UDim2.new(1,-10,0,25)
		Button.BackgroundColor3 = Color3.fromRGB(60,60,60)
		Button.TextColor3 = Color3.new(1,1,1)
		Button.Text = Name
		Button.Font = Enum.Font.SourceSansBold
		Button.TextSize = 18
		Button.TextWrapped = false
		Button.TextTruncate = Enum.TextTruncate.None
		Button.LayoutOrder = Order or 1
		Button.AutoButtonColor = false
		Button.ZIndex = 3
		Button.Parent = Content

		local C = Instance.new("UICorner")
		C.CornerRadius = UDim.new(0,6)
		C.Parent = Button

		--==================================================
		-- HOVER
		--==================================================

		Button.MouseEnter:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Color3.fromRGB(75,75,75)
				}
			):Play()

		end)

		Button.MouseLeave:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Color3.fromRGB(60,60,60),
					Size = UDim2.new(1,-10,0,25)
				}
			):Play()

		end)

		--==================================================
		-- PRESS
		--==================================================

		Button.MouseButton1Down:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(0.08),
				{
					Size = UDim2.new(1,-15,0,23)
				}
			):Play()

		end)

		Button.MouseButton1Up:Connect(function()

			TweenService:Create(
				Button,
				TweenInfo.new(
					0.12,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.new(1,-10,0,25)
				}
			):Play()

		end)

		--==================================================
		-- CALLBACK
		--==================================================

		Button.MouseButton1Click:Connect(function()

			if Callback then
				task.spawn(Callback)
			end

		end)

		return Button
	end

	return Window
end

return Library